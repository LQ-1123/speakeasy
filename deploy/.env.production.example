# SpeakEasy 服务器部署环境变量模板
# 复制到服务器：cp deploy/.env.production.example /root/speakeasy/.env  然后按需修改
# 说明：LLM / Fish / STT 的 key 都在后端（data/ 里的配置文件或本文件），
#       前端（网页 / APK / EXE）永远拿不到 key。

# ── 安全 ──────────────────────────────────────────────
# 线上必须锁定 key 编辑（App 里的设置页将不能改 key，只能改服务器 .env）
ALLOW_KEY_EDIT=0

# ── 前端来源（前后端分离时）─────────────────────────
# 允许跨域访问的前端地址，逗号分隔
CORS_ORIGINS=https://your-domain.example.com,capacitor://localhost,http://localhost

# ── 服务器出站代理（VPN）───────────────────────────
# 如果服务器用本地 http/socks 代理出网，取消注释并按实际端口修改
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# ── LLM（可只写在 data/llm_config.json；两者都存在时以配置文件为准）──
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-xxxxxxxx
# LLM_MODEL=deepseek-flash

# ── Fish Audio TTS ─────────────────────────────────
# FISH_API_KEY=xxxxxxxx
# FISH_BASE_URL=https://api.fish.audio
# FISH_MODEL=s2.1-pro-free
# FISH_REFERENCE_ID=

# ── STT（可选：云端 SiliconFlow；不填则用本地 Whisper）──
# STT_PROVIDER=siliconflow
# SILICONFLOW_API_KEY=sk-xxxxxxxx
