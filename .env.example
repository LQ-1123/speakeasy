# =============================================================================
# SpeakEasy 环境配置
# 复制为 .env 后修改。所有值都有默认值，不填也能跑（会走 mock/tone 降级）。
# =============================================================================

# ---------------------------------------------------------------------------
# LLM（OpenAI 兼容协议）
# ---------------------------------------------------------------------------
# 选一个填。留空 LLM_API_KEY 时，后端自动用内置规则引擎回复（可演示整条链路）。
#
# DeepSeek（便宜、英文不错、国内直连）：
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
#
# OpenAI：
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
#
# 任意兼容网关（one-api / new-api / SiliconFlow 等）同理。
#
# 建议服务用的小模型（留空复用主模型）。润色建议不需要强模型：
# LLM_SUGGESTION_MODEL=deepseek-chat

# ---------------------------------------------------------------------------
# HuggingFace（huggingface.co 在国内通常不可达，用镜像）
# ---------------------------------------------------------------------------
HF_ENDPOINT=https://hf-mirror.com
# 模型缓存目录（默认留空 = 用户目录下的 .cache/huggingface）
# HF_HOME=D:/models/hf

# ---------------------------------------------------------------------------
# STT：faster-whisper
# ---------------------------------------------------------------------------
# backend: auto | faster-whisper | mock
STT_BACKEND=auto
# model_size: distil-large-v3（快 2 倍，推荐）| large-v3（最准）| medium | small
STT_MODEL_SIZE=distil-large-v3
# compute_type: int8_float16（16G 显存推荐）| float16 | int8
STT_COMPUTE_TYPE=int8_float16
STT_DEVICE=cuda
# 下载目录（留空用 HF 缓存）
# STT_DOWNLOAD_ROOT=D:/models/whisper

# ---------------------------------------------------------------------------
# 云端 STT：硅基流动 SenseVoiceSmall（推荐；也可在页面「个人设置」里填，热生效）
# ---------------------------------------------------------------------------
# provider: auto（有 key 就云端，否则本地）| local（强制本地）| siliconflow（强制云端）
STT_PROVIDER=auto
STT_SILICONFLOW_API_KEY=
STT_SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
STT_SILICONFLOW_MODEL=FunAudioLLM/SenseVoiceSmall
# STT_SILICONFLOW_TIMEOUT_S=30

# 非英语（日语/韩语等）本地转写模型：distil-large-v3 是英语专用，需要多语言小模型
# 首次使用非英语语音条时会自动下载（约 500MB），可选 small / medium / large-v3
STT_MULTILINGUAL_MODEL=small

# ---------------------------------------------------------------------------
# TTS
# ---------------------------------------------------------------------------
# backend: auto | cosyvoice2 | f5tts | tone | mock
#   auto 会按 cosyvoice2 → f5tts → tone 的顺序探测，全不可用则 tone（能跑通链路）
TTS_BACKEND=auto
TTS_DEVICE=cuda
TTS_DTYPE=float16

# --- CosyVoice2 ---
# 先 git clone 仓库到 third_party/CosyVoice，再用脚本下模型
COSYVOICE_REPO_DIR=third_party/CosyVoice
COSYVOICE_MODEL_DIR=pretrained_models/CosyVoice2-0.5B
# 低延迟：JIT/TRT/vLLM 加速（首次需编译，Windows 上建议保持 false）
TTS_LOAD_JIT=false
TTS_LOAD_TRT=false
TTS_LOAD_VLLM=false

# --- F5-TTS（Windows 首选） ---
F5_REPO_DIR=third_party/F5-TTS
F5_MODEL=F5TTS_Base
# F5_CKPT_FILE=D:/models/F5TTS_Base/model_1200000.safetensors
# 采样步数：24 是延迟/质量甜点；降到 16 更快但略糊
TTS_NFE_STEP=24

# ---------------------------------------------------------------------------
# VAD：Silero-VAD
# ---------------------------------------------------------------------------
VAD_BACKEND=auto
VAD_THRESHOLD=0.5
# 多久静音算"说完了"（毫秒）。调小→更快但易截断；调大→更稳但更迟钝
VAD_MIN_SILENCE_MS=550
# 最短语音时长，低于此视为咳嗽/噪声
VAD_MIN_SPEECH_MS=200
# 前后留白，避免吃掉首尾音
VAD_SPEECH_PAD_MS=200
VAD_MAX_UTTERANCE_S=30

# ---------------------------------------------------------------------------
# 服务
# ---------------------------------------------------------------------------
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# 管线调优
# ---------------------------------------------------------------------------
# 保留几轮历史（太多会拖慢 LLM）
PIPELINE_MAX_HISTORY_TURNS=8
# 首个断句阈值，越小首包越快、但句子可能被切碎
PIPELINE_FIRST_SENTENCE_MAX_CHARS=60
# 每个 audio 帧的音频时长（毫秒）
PIPELINE_AUDIO_CHUNK_MS=200
# 每轮结束自动推送润色建议
PIPELINE_SUGGESTIONS_AUTO=true
# Mobile v4: keep secrets on the server; only a JPush app key is needed in APK config.
SE_VOICE_STRICT=1
SE_MAX_ACTIVE_CALLS=3
JPUSH_APP_KEY=
JPUSH_MASTER_SECRET=

# ---------------------------------------------------------------------------
# 账号体系：邮箱验证码 + 邀请码内测
# ---------------------------------------------------------------------------
# 完整上线/归档步骤见 docs/EMAIL_CODE_AUTH_ROLLOUT.md。
# 0 仅供旧版联调；线上不要通过关闭该开关回退到匿名自动建号。
SE_EMAIL_CODE_AUTH=1
SE_REQUIRE_AUTH=1
SE_INVITE_REQUIRED=1
SE_MAIL_DEV=0
# 使用密码学随机值，至少 32 字节；多进程/重启必须保持一致，不要提交真实密钥。
SE_EMAIL_CODE_SECRET=
# 媒体短票据使用独立随机密钥，同样至少32字节；不要使用开发默认值。
SE_MEDIA_SECRET=
# SMTP_SSL，建议使用邮箱的专用授权码而非邮箱密码。
SE_SMTP_HOST=
SE_SMTP_PORT=465
SE_SMTP_USER=
SE_SMTP_PASSWORD=
SE_SMTP_FROM=
# 青少年门禁总开关（默认关；账号恢复后再开）
SE_AGE_GATE=0
# 免登录期间的广告口径：按用户资料里自填的生日判断成年（1=允许；恢复账号登录后
# 未显式设置时自动关闭，改为要求「已核验成年账号 + 主动开启」）
SE_ADS_ANONYMOUS=0

# 2C2G capacity controls: one application worker; full turn deadline is 30s.
SE_CHAT_CONCURRENCY=32
SE_CHAT_QUEUE_SIZE=64
SE_LLM_CONCURRENCY=10
SE_LLM_QUEUE_SIZE=20
SE_CHAT_AUTO_SUGGESTIONS=0
# Request-count budgets, UTC day/calendar month; 0=disabled, not a currency cap.
# Set these from your existing provider budget. Retries also consume requests.
SE_LLM_DAILY_REQUESTS=0
SE_LLM_MONTHLY_REQUESTS=0
# Do not raise concurrency above the account's actual free/provider allowance.
SE_FISH_CONCURRENCY=5
SE_FISH_QUEUE_LIMIT=20
SE_FISH_TOTAL_TIMEOUT_S=30
SE_FISH_MP3_BITRATE=64
SE_STT_CONCURRENCY=4
SE_STT_QUEUE_LIMIT=20
SE_AUDIO_MAX_BYTES=8388608
SE_AUDIO_MAX_DURATION_S=60
SE_AUDIO_DECODE_TIMEOUT_S=10

# Multi-account pools use per-account quotas plus these independent server caps.
# Old SE_FISH/LLM/STT limits above continue to govern legacy single-key paths.
SE_PROVIDER_HTTP_LIMIT=32
SE_PROVIDER_WS_LIMIT=16
SE_PROVIDER_QUEUE_LIMIT=64
SE_PROVIDER_CLIENT_LIMIT=16
# Optional Fernet key override; empty uses data/provider-master.key (0600).
# Back up that key separately from the SQLite database; never commit it.
PROVIDER_POOL_MASTER_KEY=

