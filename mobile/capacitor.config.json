{
  "appId": "com.speakeasy.app",
  "appName": "SpeakEasy",
  "webDir": "www",
  "server": {
    "androidScheme": "http",
    "cleartext": true,
    "errorPath": "offline.html",
    "allowNavigation": [
      "*"
    ]
  },
  "android": {
    "allowMixedContent": true
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    }
  }
}